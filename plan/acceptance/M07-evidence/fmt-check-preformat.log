+fn cheap_distance(dx: f32, dy: f32) -> i32 {
+    let mut idx = rust_skia::scalar::scalar_round_to_int(dx).abs();
+    let idy = rust_skia::scalar::scalar_round_to_int(dy).abs();
+    if idx > idy {
+        idx += idy >> 1;
+    } else {
+        idx = idy + (idx >> 1);
+    }
+    idx
 }
